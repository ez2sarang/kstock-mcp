# Copy to .env (never commit .env) or put these in your MCP client's "env" block.

# KIS Open API (https://apiportal.koreainvestment.com). Paper (mock-trading) keys are separate from real keys.
# paper (default) or real
KIS_ENV=paper
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret
# Account for get_balance: "12345678-01", "1234567801", or 8 digits (product code defaults to 01).
KIS_ACCOUNT_NO=
# Alternative to KIS_ACCOUNT_NO:
# KIS_CANO=12345678
# KIS_ACNT_PRDT_CD=01

# OpenDART (https://opendart.fss.or.kr, free): disclosures, financials, IPO schedule.
DART_API_KEY=your-dart-api-key

# Optional: where tokens and symbol/company caches are stored (default ~/.cache/kstock-mcp).
# KSTOCK_MCP_CACHE_DIR=
